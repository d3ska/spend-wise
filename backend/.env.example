# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=30s

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=spendwise
DB_SSLMODE=disable
DB_MAX_CONNS=10

# Auth bypass (dev only — skips OAuth, auto-creates a dev user)
AUTH_BYPASS=false

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRY=24h

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=https://localhost:3000/auth/google/callback

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=https://localhost:3000/auth/github/callback

# Cookie settings
COOKIE_DOMAIN=
COOKIE_SECURE=false

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=https://localhost:3000

# Enable Banking
ENABLEBANKING_APP_ID=
ENABLEBANKING_KEY_PATH=
ENABLEBANKING_BASE_URL=https://api.enablebanking.com
